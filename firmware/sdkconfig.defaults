# Frame payloads arrive over UART at this rate. 115200 is safe on CH340 clones;
# raise it once the link is proven stable.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# The receive task parses frames byte-at-a-time from a ring buffer; the default
# 10ms tick makes the inter-byte timeout granularity coarser than we want.
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_TASK_WDT_EN=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The ESP32-D0WD-V3 boards used here carry 4MB; without this the image header
# claims 2MB and the bootloader logs a size-mismatch warning on every boot.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Debug bridge: accept frames from the host over the same USB-serial cable.
# UART0 is shared with the console, so log output can interleave; frames arrive
# on RX and logs leave on TX, so inbound frames are not corrupted by it.
CONFIG_FRAME_UART_ENABLE=y
CONFIG_FRAME_UART_NUM=0

# Determined empirically with the corner probe on 2026-07-20: the module is
# column-addressed (digit selects a column) with bit 0 at the top, which is
# index 5 = transpose + flipY. Derived from the four observed corners and
# confirmed by simulation before flashing.
CONFIG_MAX7219_ORIENTATION=5

# Socket budget.
#
# The default lwIP pool is 10. The HTTP server asks for 7 clients plus a
# listener, and the captive DNS holds a UDP socket - 9 of 10, with one spare.
#
# A phone validating a network opens several connections at once (HTTP probe,
# HTTPS probe, the portal fetch), which exhausts the pool. accept() then fails
# with ENFILE and the phone sees refused connections at exactly the moment it
# is deciding whether this is a captive portal - so it concludes the network is
# broken rather than portalled, and no sign-in banner appears.
#
# Observed directly as: httpd_accept_conn: error in accept (23)
CONFIG_LWIP_MAX_SOCKETS=16
