menu "Arabic LED text pipeline"

    menu "MAX7219 wiring"

        config MAX7219_PIN_CLK
            int "CLK (SPI clock) GPIO"
            default 14
            help
                GPIO14 is HSPI's native SCK, and sits on the same header edge
                as VIN/GND. See docs/wiring.md.

        config MAX7219_PIN_DIN
            int "DIN (SPI MOSI) GPIO"
            default 13
            help
                GPIO13 is HSPI's native MOSI, adjacent to GND on the power edge.

        config MAX7219_PIN_CS
            int "CS (chip select / LOAD) GPIO"
            default 27
            help
                GPIO27, not the physically closer GPIO12: GPIO12 is the MTDI
                strapping pin and must be LOW at reset. A MAX7219 CS line
                floating or pulled high at boot would select 1.8V flash and
                brick the boot until the wire is removed.

        config MAX7219_MODULES
            int "Number of cascaded 8x8 modules"
            range 1 16
            default 4
            help
                A common "4-in-1" board is 4 modules = 32x8 pixels.

        config MAX7219_INTENSITY
            int "Initial brightness (0-15)"
            range 0 15
            default 2
            help
                MAX7219 at full intensity draws a lot of current; 2 is a safe
                default for USB-powered bring-up.

    endmenu

    choice MAX7219_ORIENTATION
        prompt "Module pixel mapping"
        default MAX7219_MAP_UNKNOWN
        help
            Generic MAX7219 boards differ in how the chip's digit/segment lines
            are wired to the LED grid, and it cannot be detected in software.
            Run the bring-up pattern (see docs/bringup.md) and pick the mapping
            whose output matches what you actually see on the panel.

        config MAX7219_MAP_UNKNOWN
            bool "Not yet determined - boot into bring-up pattern"
        config MAX7219_MAP_ROW
            bool "Row-addressed (digit N = pixel row N)"
        config MAX7219_MAP_COL
            bool "Column-addressed (digit N = pixel column N)"
        config MAX7219_MAP_ROW_REV
            bool "Row-addressed, columns reversed"
        config MAX7219_MAP_COL_REV
            bool "Column-addressed, rows reversed"
    endchoice

    menu "WiFi access point"

        config AP_SSID
            string "Access point name (SSID)"
            default "ARABIC-LED"
            help
                The network the phone joins. No router is involved.

        config AP_PASSWORD
            string "Access point password"
            default ""
            help
                Leave empty for an open network. WPA2 requires at least 8
                characters - a shorter one is rejected outright, so the
                firmware falls back to open rather than failing to start.

    endmenu

    menu "Frame link"

        config FRAME_UART_ENABLE
            bool "Also accept frames over UART"
            default n
            help
                The web UI is the primary transport, so this is off by default.

                Installing the UART driver on UART0 fights the console driver
                that ESP-IDF logs through, which corrupts log output. If you
                enable this, put it on UART1 or UART2 with its own pins rather
                than sharing UART0 with the console.

        config FRAME_UART_NUM
            int "UART port number"
            depends on FRAME_UART_ENABLE
            range 0 2
            default 2
            help
                Avoid 0: it is the console port. See the warning above.

        config FRAME_UART_BAUD
            int "UART baud rate"
            depends on FRAME_UART_ENABLE
            default 115200

        config FRAME_MAX_PAYLOAD
            int "Maximum frame payload (bytes)"
            default 512
            help
                64x32 needs 256. 512 leaves room for wider scroll buffers.

    endmenu

endmenu
